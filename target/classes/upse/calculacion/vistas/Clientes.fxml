<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="dataPaneCliente" prefHeight="400.0" prefWidth="600.0" spacing="12.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="upse.calculacion.controlador.ClientesController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="%clientes.titulo" />
      <HBox spacing="10.0">
         <children>
            <TextField promptText="%clientes.buscar" prefWidth="250.0" />
            <Button mnemonicParsing="false" text="%clientes.btnBuscar" />
            <Button mnemonicParsing="false" onAction="#acc_nuevoCliente" text="%clientes.btnNuevo" />
         </children>
      </HBox>
      <TableView prefHeight="250.0">
         <columns>
            <TableColumn prefWidth="120.0" text="%clientes.colCedula" />
            <TableColumn prefWidth="200.0" text="%clientes.colNombres" />
            <TableColumn prefWidth="130.0" text="%clientes.colDireccion" />
            <TableColumn prefWidth="100.0" text="%clientes.colTelefono" />
         </columns>
      </TableView>
      <HBox spacing="10.0">
         <children>
            <Button mnemonicParsing="false" text="%clientes.btnModificar" />
            <Button mnemonicParsing="false" text="%clientes.btnEliminar" />
            <Button mnemonicParsing="false" onAction="#acc_cerrar" text="%clientes.btnCerrar" />
         </children>
      </HBox>
   </children>
</VBox>