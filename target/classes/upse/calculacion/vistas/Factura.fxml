<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="facturaPane" prefHeight="700.0" prefWidth="852.0" spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="upse.calculacion.controlador.FacturaController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <AnchorPane prefHeight="231.0" prefWidth="823.0" styleClass="anchor-pane-header" VBox.vgrow="NEVER">
         <children>
            <Label layoutX="32.0" layoutY="26.0" text="%factura.nroFactura" />
            <TextField fx:id="txt_numFactura" layoutX="113.0" layoutY="22.0" />
            <Label layoutX="446.0" layoutY="26.0" text="Fecha:" />
            <TextField fx:id="txt_fecha" layoutX="527.0" layoutY="22.0" />
            <Label layoutX="32.0" layoutY="60.0" text="%cliente.cedula" />
            <TextField fx:id="txt_cedula" layoutX="113.0" layoutY="56.0" onAction="#acc_buscarCliente" prefHeight="25.0" prefWidth="149.0" />
            <Label layoutX="32.0" layoutY="92.0" text="%cliente.nombres" />
            <TextField fx:id="txt_nombres" layoutX="113.0" layoutY="88.0" prefHeight="25.0" prefWidth="415.0" />
            <Label layoutX="32.0" layoutY="129.0" text="%cliente.telefono" />
            <TextField fx:id="txt_telefono" layoutX="113.0" layoutY="125.0" prefHeight="25.0" prefWidth="149.0" />
            <Label layoutX="298.0" layoutY="129.0" text="%cliente.correo" />
            <TextField fx:id="txt_correo" layoutX="379.0" layoutY="125.0" prefHeight="25.0" prefWidth="149.0" />
            <Label layoutX="32.0" layoutY="166.0" text="%cliente.direccion" />
            <TextField fx:id="txt_direccion" layoutX="113.0" layoutY="162.0" prefHeight="52.0" prefWidth="415.0" />
            <CheckBox fx:id="chk_validar" layoutX="280.0" layoutY="60.0" mnemonicParsing="false" text="%cliente.validar" />
         </children>
      </AnchorPane>
      <TableView prefHeight="246.0" prefWidth="823.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn prefWidth="104.0" text="%factura.colCodigo" />
          <TableColumn prefWidth="165.0" text="%factura.colDescripcion" />
            <TableColumn minWidth="2.0" prefWidth="78.0" text="%factura.colCant" />
            <TableColumn minWidth="0.0" prefWidth="84.0" text="%factura.colVUnit" />
            <TableColumn prefWidth="164.0" text="%factura.subtotal" />
            <TableColumn prefWidth="133.0" text="APLICA IVA" />
            <TableColumn prefWidth="94.0" text="%factura.total" />
        </columns>
      </TableView>
      <HBox alignment="CENTER_RIGHT" spacing="20.0" styleClass="footer-bar" VBox.vgrow="NEVER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button fx:id="btn_grabar" mnemonicParsing="false" onAction="#acc_grabar" text="%factura.btnGuardar" />
                  <Button fx:id="btn_anular" mnemonicParsing="false" onAction="#acc_anular" text="Anular" />
                  <Button fx:id="btn_nuevo" mnemonicParsing="false" onAction="#acc_nuevo" text="Nuevo" />
                  <Button fx:id="btn_cerrar" mnemonicParsing="false" onAction="#acc_cerrar" text="%factura.btnCerrar" />
               </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER_RIGHT" spacing="5.0">
               <children>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Label text="%factura.subtotal" />
                        <TextField fx:id="txt_subtotal" prefWidth="120.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Label text="SUBTOTAL 0%:" />
                        <TextField fx:id="txt_subtotal0" prefWidth="120.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Label text="%factura.iva" />
                        <TextField fx:id="txt_iva" prefWidth="120.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Label text="%factura.total" />
                        <TextField fx:id="txt_total" prefWidth="120.0" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>