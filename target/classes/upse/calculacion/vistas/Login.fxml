<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" spacing="20.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="upse.calculacion.controlador.LoginController">
   <children>
      <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Login Sistema" />
      <TextField fx:id="txt_usuario" maxWidth="200.0" promptText="Usuario" />
      <PasswordField fx:id="txt_password" maxWidth="200.0" promptText="Contraseña" />
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#acc_validar" prefWidth="100.0" text="Ingresar" />
            <Button mnemonicParsing="false" onAction="#acc_cerrar" prefWidth="100.0" text="Cerrar" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
