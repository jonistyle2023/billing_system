<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="productoPane" prefHeight="400.0" prefWidth="600.0" spacing="12.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="upse.calculacion.controlador.ProductoController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Administracion de productos" />
      <HBox spacing="10.0">
         <children>
            <TextField promptText="Buscar Producto" prefWidth="250.0" />
            <Button mnemonicParsing="false" text="Buscar" />
            <Button mnemonicParsing="false" text="Nuevo Producto" />
         </children>
      </HBox>
      <TableView prefHeight="250.0">
         <columns>
            <TableColumn prefWidth="120.0" text="Codigo" />
            <TableColumn prefWidth="260.0" text="Descripcion" />
            <TableColumn prefWidth="120.0" text="Precio" />
         </columns>
      </TableView>
      <HBox spacing="10.0">
         <children>
            <Button mnemonicParsing="false" text="Modificar" />
            <Button mnemonicParsing="false" text="Eliminar" />
            <Button mnemonicParsing="false" onAction="#acc_volver" text="Volver" />
         </children>
      </HBox>
   </children>
</VBox>
