<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="productoPane" prefHeight="400.0" prefWidth="600.0" spacing="12.0" styleClass="root" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="upse.calculacion.controlador.ProductoController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="%producto.titulo" />
      <HBox spacing="10.0">
         <children>
            <TextField promptText="%producto.buscar" prefWidth="250.0" />
            <Button mnemonicParsing="false" text="%producto.btnBuscar" />
            <Button mnemonicParsing="false" text="%producto.btnNuevo" />
         </children>
      </HBox>
      <TableView prefHeight="250.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn prefWidth="120.0" text="%producto.colCodigo" />
            <TableColumn prefWidth="260.0" text="%producto.colDescripcion" />
            <TableColumn prefWidth="120.0" text="%producto.colPrecio" />
         </columns>
      </TableView>
      <HBox spacing="10.0" styleClass="footer-bar">
         <children>
            <Button mnemonicParsing="false" text="%producto.btnModificar" />
            <Button mnemonicParsing="false" text="%producto.btnEliminar" />
            <Button mnemonicParsing="false" onAction="#acc_volver" text="%producto.btnVolver" />
         </children>
      </HBox>
   </children>
</VBox>
