<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="reporte_productos" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="6f6f7f10-1a2b-4c3d-8e9f-000000000002">

    <parameter name="empresaNombre" class="java.lang.String"/>
    <parameter name="empresaDireccion" class="java.lang.String"/>
    <parameter name="empresaTelefono" class="java.lang.String"/>
    <parameter name="titulo" class="java.lang.String"/>
    <parameter name="subtitulo" class="java.lang.String"/>
    <parameter name="fechaGeneracion" class="java.lang.String"/>

    <field name="codigo" class="java.lang.String"><fieldDescription><![CDATA[codigo]]></fieldDescription></field>
    <field name="nombre" class="java.lang.String"><fieldDescription><![CDATA[nombre]]></fieldDescription></field>
    <field name="precioCompra" class="java.lang.Float"><fieldDescription><![CDATA[precioCompra]]></fieldDescription></field>
    <field name="pvpMenor" class="java.lang.Float"><fieldDescription><![CDATA[pvpMenor]]></fieldDescription></field>
    <field name="pvpMayor" class="java.lang.Float"><fieldDescription><![CDATA[pvpMayor]]></fieldDescription></field>
    <field name="stock" class="java.lang.Float"><fieldDescription><![CDATA[stock]]></fieldDescription></field>
    <field name="aplicaIva" class="java.lang.Boolean"><fieldDescription><![CDATA[aplicaIva]]></fieldDescription></field>

    <title>
        <band height="70">
            <textField>
                <reportElement x="0" y="0" width="802" height="20"/>
                <textElement><font size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{empresaNombre}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="20" width="802" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{empresaDireccion} + ($P{empresaTelefono} == null || $P{empresaTelefono}.isEmpty() ? "" : " - " + $P{empresaTelefono})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="40" width="802" height="16"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{titulo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="56" width="802" height="12"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{subtitulo}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="70" height="20" backcolor="#2C3E50" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Código]]></text>
            </staticText>
            <staticText>
                <reportElement x="70" y="0" width="220" height="20" backcolor="#2C3E50" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Nombre]]></text>
            </staticText>
            <staticText>
                <reportElement x="290" y="0" width="100" height="20" backcolor="#2C3E50" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle" textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[P. Compra]]></text>
            </staticText>
            <staticText>
                <reportElement x="390" y="0" width="100" height="20" backcolor="#2C3E50" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle" textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[PVP Menor]]></text>
            </staticText>
            <staticText>
                <reportElement x="490" y="0" width="100" height="20" backcolor="#2C3E50" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle" textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[PVP Mayor]]></text>
            </staticText>
            <staticText>
                <reportElement x="590" y="0" width="90" height="20" backcolor="#2C3E50" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle" textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Stock]]></text>
            </staticText>
            <staticText>
                <reportElement x="680" y="0" width="122" height="20" backcolor="#2C3E50" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle" textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Aplica IVA]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="70" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="70" y="0" width="220" height="18"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>
            <textField pattern="'$' #,##0.00">
                <reportElement x="290" y="0" width="100" height="18"/>
                <textElement verticalAlignment="Middle" textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{precioCompra}]]></textFieldExpression>
            </textField>
            <textField pattern="'$' #,##0.00">
                <reportElement x="390" y="0" width="100" height="18"/>
                <textElement verticalAlignment="Middle" textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{pvpMenor}]]></textFieldExpression>
            </textField>
            <textField pattern="'$' #,##0.00">
                <reportElement x="490" y="0" width="100" height="18"/>
                <textElement verticalAlignment="Middle" textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{pvpMayor}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="590" y="0" width="90" height="18"/>
                <textElement verticalAlignment="Middle" textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{stock}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="680" y="0" width="122" height="18"/>
                <textElement verticalAlignment="Middle" textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{aplicaIva} ? "Sí" : "No"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="500" height="16"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Generado el " + $P{fechaGeneracion}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="700" y="0" width="102" height="16"/>
                <textElement textAlignment="Right"><font size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
