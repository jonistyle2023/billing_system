            <staticText>
                <reportElement x="465" y="0" width="90" height="18" backcolor="#2C3E50" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="50" height="16"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>
