    <field name="prod_cod" class="java.lang.String"><fieldDescription><![CDATA[prod_cod]]></fieldDescription></field>
    <field name="prod_nombre" class="java.lang.String"><fieldDescription><![CDATA[prod_nombre]]></fieldDescription></field>
    <field name="cantidad" class="java.lang.Float"><fieldDescription><![CDATA[cantidad]]></fieldDescription></field>
    <field name="precio" class="java.lang.Float"><fieldDescription><![CDATA[precio]]></fieldDescription></field>
    <field name="total" class="java.lang.Float"><fieldDescription><![CDATA[total]]></fieldDescription></field>

    <title>
        <band height="150">
            <textField>
                <reportElement x="0" y="0" width="330" height="18"/>
                <textElement><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{empresaNombre}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="18" width="330" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["R.U.C.: " + $P{empresaRuc}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="32" width="330" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{empresaDireccion}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="46" width="330" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Telf.: " + $P{empresaTelefono}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="60" width="330" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Obligado a llevar contabilidad: " + $P{obligadoContabilidad}]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="335" y="0" width="220" height="90"/>
            </rectangle>
            <textField>
                <reportElement x="340" y="4" width="210" height="16"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["FACTURA No. " + $P{numeroFactura}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="340" y="22" width="210" height="12"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["AMBIENTE: " + ("2".equals($P{ambiente}) ? "PRODUCCIÓN" : "PRUEBAS")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="340" y="34" width="210" height="12"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["ESTADO SRI: " + $P{estadoSri}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="340" y="46" width="210" height="12"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Núm. Autorización: " + (($P{numeroAutorizacion} == null || $P{numeroAutorizacion}.isEmpty()) ? "(pendiente)" : $P{numeroAutorizacion})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="340" y="58" width="210" height="12"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Fecha aut.: " + (($P{fechaAutorizacion} == null || $P{fechaAutorizacion}.isEmpty()) ? "(pendiente)" : $P{fechaAutorizacion})]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="335" y="98" width="220" height="10"/>
                <textElement textAlignment="Center"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[CLAVE DE ACCESO]]></text>
            </staticText>
            <textField>
                <reportElement x="335" y="108" width="220" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7" pdfFontName="Courier"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{claveAcceso}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="140" width="555" height="1"/>
            </line>
        </band>
    </title>

    <pageHeader>
        <band height="60">
            <textField>
