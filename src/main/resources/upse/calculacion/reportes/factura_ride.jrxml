                <text><![CDATA[Cant.]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="70" height="18" backcolor="#2C3E50" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Código]]></text>
            </staticText>
            <staticText>
                <reportElement x="120" y="0" width="255" height="18" backcolor="#2C3E50" mode="Opaque" forecolor="#FFFFFF"/>
