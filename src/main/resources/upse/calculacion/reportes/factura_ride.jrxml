                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{prod_nombre}]]></textFieldExpression>
            </textField>
            <textField pattern="'$' #,##0.00">
                <reportElement x="375" y="0" width="90" height="16"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{precio}]]></textFieldExpression>
            </textField>
            <textField pattern="'$' #,##0.00">
                <reportElement x="465" y="0" width="90" height="16"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{total}]]></textFieldExpression>
