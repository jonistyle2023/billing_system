<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" prefWidth="700.0" prefHeight="500.0"
      xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="upse.calculacion.controlador.BuscarProductoController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label text="%buscarProducto.titulo" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

      <HBox spacing="10.0" alignment="CENTER_LEFT">
         <children>
            <TextField fx:id="txt_buscar" promptText="%buscarProducto.buscarHint"
                       HBox.hgrow="ALWAYS" onAction="#acc_buscar" />
            <Button text="%buscarProducto.btnBuscar" onAction="#acc_buscar"
                    defaultButton="false" />
         </children>
      </HBox>

      <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
         <columns>
               <TableColumn fx:id="colImg" prefWidth="65.0" text="%buscarProducto.colImagen" />
            <TableColumn fx:id="colCod" prefWidth="100.0" text="%buscarProducto.colCodigo" />
            <TableColumn fx:id="colNombre" prefWidth="230.0" text="%buscarProducto.colNombre" />
            <TableColumn fx:id="colPrecio" prefWidth="90.0" text="%buscarProducto.colPrecio" />
            <TableColumn fx:id="colStock" prefWidth="80.0" text="%buscarProducto.colStock" />
            <TableColumn fx:id="colIva" prefWidth="90.0" text="%buscarProducto.colIva" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btn_agregar" text="%buscarProducto.btnAgregar" onAction="#acc_agregar"
                    style="-fx-background-color: #27ae60;" />
            <Button text="%buscarProducto.btnCancelar" onAction="#acc_cancelar" />
         </children>
      </HBox>
   </children>
</VBox>
