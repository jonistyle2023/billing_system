<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="dataPaneCliente" prefHeight="400.0" prefWidth="600.0" spacing="12.0" styleClass="root" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="upse.calculacion.controlador.ClientesController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="%clientes.titulo" />
      <HBox spacing="10.0">
         <children>
            <TextField fx:id="txt_buscar" onAction="#acc_buscar" promptText="%clientes.buscar" prefWidth="250.0" />
            <Button mnemonicParsing="false" onAction="#acc_buscar" text="%clientes.btnBuscar" />
            <Button mnemonicParsing="false" onAction="#acc_nuevoCliente" text="%clientes.btnNuevo" />
         </children>
      </HBox>
       <TableView fx:id="tblClientes" prefHeight="250.0" VBox.vgrow="ALWAYS">
          <columns>
             <TableColumn fx:id="colCedula" prefWidth="120.0" text="%clientes.colCedula" />
             <TableColumn fx:id="colNombres" prefWidth="200.0" text="%clientes.colNombres" />
             <TableColumn fx:id="colDireccion" prefWidth="130.0" text="%clientes.colDireccion" />
             <TableColumn fx:id="colTelefono" prefWidth="100.0" text="%clientes.colTelefono" />
          </columns>
       </TableView>
      <HBox spacing="10.0" styleClass="footer-bar">
         <children>
            <Button fx:id="btn_modificar" mnemonicParsing="false" onAction="#acc_modificar" text="%clientes.btnModificar" />
            <Button fx:id="btn_eliminar" mnemonicParsing="false" onAction="#acc_eliminar" text="%clientes.btnEliminar" />
         </children>
      </HBox>
   </children>
</VBox>
