<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="upse.calculacion.controlador.PrincipalController">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <MenuBar BorderPane.alignment="CENTER">
               <menus>
                  <Menu mnemonicParsing="false" text="%principal.archivo">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#acc_abrirClientes" text="%principal.clientes" />
                        <MenuItem mnemonicParsing="false" onAction="#acc_abrirClienteModal" text="%principal.nuevoCliente" />
                        <MenuItem mnemonicParsing="false" onAction="#acc_abrirProductos" text="%principal.productos" />
                        <MenuItem mnemonicParsing="false" onAction="#acc_cerrarSesion" text="%principal.cerrarSesion" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="%principal.facturar">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#acc_abrirFactura" text="%principal.nuevaFactura" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="%principal.reportes">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#acc_salir" text="%principal.salir" />
                     </items>
                  </Menu>
               </menus>
            </MenuBar>
         </top>

         <left>
            <Accordion BorderPane.alignment="TOP_LEFT">
               <panes>
                  <TitledPane animated="false" text="%principal.tituloArchivo">
                     <content>
                        <VBox spacing="4.0" alignment="TOP_CENTER">
                           <padding><Insets top="8.0" bottom="8.0" left="6.0" right="6.0" /></padding>
                           <children>
                              <Button mnemonicParsing="false" onAction="#acc_abrirClientes"
                                      prefHeight="65.0" prefWidth="104.0"
                                      text="%principal.btnClientes" contentDisplay="TOP">
                                 <graphic>
                                    <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                                       <image><Image url="@recursos/business-people.png" /></image>
                                    </ImageView>
                                 </graphic>
                              </Button>
                              <Button mnemonicParsing="false" onAction="#acc_abrirProductos"
                                      prefHeight="65.0" prefWidth="104.0"
                                      text="%principal.btnProductos" contentDisplay="TOP">
                                 <graphic>
                                    <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                                       <image><Image url="@recursos/agregar-producto.png" /></image>
                                    </ImageView>
                                 </graphic>
                              </Button>
                           </children>
                        </VBox>
                     </content>
                  </TitledPane>

                  <TitledPane animated="false" text="%principal.tituloFacturacion">
                     <content>
                        <VBox spacing="4.0" alignment="TOP_CENTER">
                           <padding><Insets top="8.0" bottom="8.0" left="6.0" right="6.0" /></padding>
                           <children>
                              <Button mnemonicParsing="false" onAction="#acc_abrirFactura"
                                      prefHeight="65.0" prefWidth="104.0"
                                      text="%principal.btnFactura" contentDisplay="TOP">
                                 <graphic>
                                    <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                                       <image><Image url="@recursos/maquina-de-fax.png" /></image>
                                    </ImageView>
                                 </graphic>
                              </Button>
                           </children>
                        </VBox>
                     </content>
                  </TitledPane>

                  <TitledPane animated="false" text="%principal.empresa">
                     <content>
                        <VBox spacing="3.0">
                           <padding><Insets top="8.0" bottom="8.0" left="8.0" right="8.0" /></padding>
                           <children>
                              <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;" text="%principal.empresaNombre" />
                              <Label fx:id="lbl_empresaNombre" prefWidth="140.0" wrapText="true" style="-fx-font-size: 11px;" />
                              <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;" text="%principal.empresaDireccion" />
                              <Label fx:id="lbl_empresaDireccion" prefWidth="140.0" wrapText="true" style="-fx-font-size: 11px;" />
                              <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;" text="%principal.empresaTelefono" />
                              <Label fx:id="lbl_empresaTelefono" prefWidth="140.0" wrapText="true" style="-fx-font-size: 11px;" />
                           </children>
                        </VBox>
                     </content>
                  </TitledPane>
               </panes>
            </Accordion>
         </left>

         <bottom>
            <HBox alignment="CENTER_LEFT" prefHeight="34.0" spacing="6.0"
                  style="-fx-background-color: #dde4f0; -fx-border-color: #bdc3c7 transparent transparent transparent; -fx-border-width: 1 0 0 0;"
                  BorderPane.alignment="CENTER">
               <padding><Insets left="12.0" right="12.0" /></padding>
               <children>
                  <Label text="%principal.usuario" style="-fx-font-size: 12px; -fx-text-fill: #5d6d7e;" />
                  <Label fx:id="lbl_usuario" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label text="%principal.idioma" style="-fx-font-size: 12px; -fx-text-fill: #5d6d7e;" />
                  <ComboBox fx:id="cmb_idioma" onAction="#acc_cambiarIdioma" prefWidth="100.0" style="-fx-font-size: 12px;" />
               </children>
            </HBox>
         </bottom>

         <center>
            <AnchorPane fx:id="dataPane" style="-fx-background-color: #f5f6fa;" BorderPane.alignment="CENTER" />
         </center>
      </BorderPane>
   </children>
</AnchorPane>
