<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="upse.calculacion.controlador.PrincipalController">
   <children>
      <BorderPane prefHeight="400.0" prefWidth="606.0" style="-fx-background-color: #f4f263;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <MenuBar prefHeight="25.0" prefWidth="161.0" BorderPane.alignment="CENTER">
              <menus>
                <Menu mnemonicParsing="false" text="%principal.archivo">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#acc_abrirClientes" text="%principal.clientes" />
                        <MenuItem mnemonicParsing="false" onAction="#acc_abrirClienteModal" text="%principal.nuevoCliente" />
                        <MenuItem mnemonicParsing="false" onAction="#acc_abrirProductos" text="%principal.productos" />
                        <MenuItem mnemonicParsing="false" onAction="#acc_cerrarSesion" text="%principal.cerrarSesion" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="%principal.facturar">
                  <items>
                     <MenuItem mnemonicParsing="false" onAction="#acc_abrirFactura" text="%principal.nuevaFactura" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="%principal.reportes">
                  <items>
                     <MenuItem mnemonicParsing="false" onAction="#acc_salir" text="%principal.salir" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
         </top>
         <left>
            <Accordion prefHeight="255.0" prefWidth="98.0" BorderPane.alignment="CENTER">
              <panes>
                <TitledPane animated="false" prefHeight="325.0" prefWidth="101.0" text="%principal.tituloArchivo">
                  <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="299.0" prefWidth="129.0">
                           <children>
                               <Button layoutX="14.0" layoutY="19.0" mnemonicParsing="false" onAction="#acc_abrirClientes" prefHeight="82.0" prefWidth="68.0" text="%principal.btnClientes" contentDisplay="TOP">
                                  <graphic>
                                      <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                         <image>
                                            <Image url="@recursos/business-people.png" />
                                         </image>
                                      </ImageView>
                                  </graphic>
                               </Button>
                               <Button layoutX="14.0" layoutY="109.0" mnemonicParsing="false" onAction="#acc_abrirProductos" prefHeight="82.0" prefWidth="68.0" text="%principal.btnProductos" contentDisplay="TOP">
                                  <graphic>
                                      <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                         <image>
                                            <Image url="@recursos/agregar-producto.png" />
                                         </image>
                                      </ImageView>
                                  </graphic>
                               </Button>
                           </children>
                        </AnchorPane>
                  </content>
                </TitledPane>
                <TitledPane animated="false" text="%principal.tituloFacturacion">
                  <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                        <children>
                            <Button layoutX="14.0" layoutY="19.0" mnemonicParsing="false" onAction="#acc_abrirFactura" prefHeight="82.0" prefWidth="69.0" text="%principal.btnFactura" contentDisplay="TOP">
                               <graphic>
                                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                     <image>
                                        <Image url="@recursos/maquina-de-fax.png" />
                                     </image>
                                  </ImageView>
                               </graphic>
                            </Button>
                        </children>
                    </AnchorPane>
                  </content>
                </TitledPane>
                <TitledPane animated="false" prefHeight="325.0" prefWidth="0.0" text="untitled 3">
                  <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
                  </content>
                </TitledPane>
              </panes>
            </Accordion>
         </left>
         <bottom>
            <AnchorPane prefHeight="39.0" prefWidth="606.0" style="-fx-background-color: #eeeeff;" BorderPane.alignment="CENTER">
               <children>
                  <Text layoutX="14.0" layoutY="24.0" strokeType="OUTSIDE" strokeWidth="0.0" text="%principal.usuario" />
                  <Label layoutX="65.0" layoutY="11.0" text="Jonathan Panchana" />
                  <HBox alignment="CENTER_RIGHT" layoutX="380.0" layoutY="6.0" prefHeight="27.0" prefWidth="200.0" spacing="10.0" AnchorPane.rightAnchor="14.0">
                     <children>
                        <Label text="%principal.idioma" />
                        <ComboBox fx:id="cmb_idioma" onAction="#acc_cambiarIdioma" prefWidth="100.0" />
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
         </bottom>
         <center>
             <AnchorPane fx:id="dataPane" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #f8f8ff;" BorderPane.alignment="CENTER" />
         </center>
      </BorderPane>
   </children>
</AnchorPane>