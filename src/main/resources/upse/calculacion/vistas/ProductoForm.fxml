<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="root" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="upse.calculacion.controlador.ProductoFormController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="%productoForm.titulo" />
      <GridPane hgap="12.0" vgap="10.0">
         <columnConstraints>
            <ColumnConstraints minWidth="100.0" prefWidth="110.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="160.0" prefWidth="200.0" />
         </columnConstraints>
         <children>
            <Label text="%productoForm.codigo" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txt_codigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="%productoForm.nombre" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txt_nombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="%productoForm.precioCompra" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txt_precioCompra" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="%productoForm.pvpMenor" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="txt_pvpMenor" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="%productoForm.pvpMayor" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="txt_pvpMayor" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label text="%productoForm.stock" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <TextField fx:id="txt_stock" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <Label text="%productoForm.imagen" GridPane.columnIndex="0" GridPane.rowIndex="6"
                   GridPane.valignment="TOP" />
            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
               <StackPane prefWidth="120.0" prefHeight="120.0"
                          style="-fx-border-color: #cccccc; -fx-border-width: 1; -fx-background-color: #f5f5f5;">
                  <ImageView fx:id="imgPreview" fitWidth="118.0" fitHeight="118.0" preserveRatio="true" />
               </StackPane>
               <HBox spacing="6.0">
                  <Button text="%productoForm.seleccionarImagen" onAction="#acc_seleccionarImagen" />
                  <Button fx:id="btn_quitarImagen" text="%productoForm.quitarImagen"
                          onAction="#acc_quitarImagen"
                          style="-fx-background-color: #e74c3c; -fx-text-fill: white;"
                          visible="false" managed="false" />
               </HBox>
               <Label fx:id="lbl_nombreImagen" text=""
                      style="-fx-font-size: 11px; -fx-text-fill: #888888;" />
            </VBox>

            <CheckBox fx:id="chk_iva" text="%productoForm.iva" GridPane.columnIndex="1" GridPane.rowIndex="7" />
         </children>
      </GridPane>
      <HBox spacing="10.0" styleClass="footer-bar">
         <children>
            <Button mnemonicParsing="false" onAction="#acc_guardar" text="%productoForm.guardar" />
            <Button mnemonicParsing="false" onAction="#acc_cancelar" text="%productoForm.cancelar"
                    style="-fx-background-color: #95a5a6;" />
         </children>
      </HBox>
   </children>
</VBox>
